# ── Wallet Reputation Layer — environment variables ───────────────────────────
# Copy this file to .env and fill in real values. Never commit .env.

# Optional: Ethereum mainnet RPC URL (defaults to cloudflare-eth.com if not set)
# ETH_RPC_URL=https://your-rpc-url

# Optional: private key for contract deployments (not needed for the frontend)
# DEPLOYER_PRIVATE_KEY=0x...
